# Required. PostgreSQL connection string (e.g. from Neon, Supabase, or local Postgres).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required. Groq API key used to generate quizzes.
GROQ_API_KEY=your_groq_api_key_here

# Optional. Groq-hosted model to use for generation.
LLM_MODEL=openai/gpt-oss-20b

# Required. Clerk secret key, from the Clerk dashboard (API Keys).
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Optional. Clerk JWT verification key (PEM), from the Clerk dashboard (API Keys > JWT
# templates / Advanced). Enables local token verification instead of a network call
# to Clerk on every request. Leave unset to fall back to the JWKS network check.
CLERK_JWT_KEY=

# Comma-separated list of frontend origins allowed to call this API and present
# Clerk tokens to it. Must match where the frontend is served from.
ALLOWED_ORIGINS=http://localhost:5173
